msgstr "[+] Phóng to để thấy ít công trình hơn nhưng chi tiết rõ hơn"

msgid "[-] Zoom out"
msgstr "[-] Thu nhỏ"

msgid "[F1] Press this button to get help"
msgstr "[F1] Bấm nút này để được trợ giúp"

